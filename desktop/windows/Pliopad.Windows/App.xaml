<Application x:Class="Pliopad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Notion's palette: warm off-white sidebar, soft gray hover, charcoal text. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PSidebar" Color="#F7F7F5" />
          <SolidColorBrush x:Key="PText" Color="#37352F" />
          <SolidColorBrush x:Key="PMuted" Color="#8C8A85" />
          <SolidColorBrush x:Key="PFaint" Color="#B9B8B4" />
          <SolidColorBrush x:Key="PHover" Color="#0F37352F" />
          <SolidColorBrush x:Key="PSelected" Color="#1A37352F" />
          <SolidColorBrush x:Key="PBorder" Color="#E9E9E7" />
          <SolidColorBrush x:Key="PCard" Color="#FBFBFA" />
          <SolidColorBrush x:Key="PCode" Color="#F7F6F3" />
          <SolidColorBrush x:Key="PCallout" Color="#F1F1EF" />
          <SolidColorBrush x:Key="PAccent" Color="#647BFF" />
          <SolidColorBrush x:Key="PRed" Color="#E03E3E" />
          <SolidColorBrush x:Key="POrange" Color="#D9730D" />
          <SolidColorBrush x:Key="PGreen" Color="#0F7B6C" />
          <SolidColorBrush x:Key="PScrim" Color="#66000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PBg" Color="#191919" />
          <SolidColorBrush x:Key="PSidebar" Color="#202020" />
          <SolidColorBrush x:Key="PText" Color="#E6E6E4" />
          <SolidColorBrush x:Key="PMuted" Color="#9B9B98" />
          <SolidColorBrush x:Key="PFaint" Color="#5A5A58" />
          <SolidColorBrush x:Key="PHover" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="PSelected" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="PBorder" Color="#2F2F2F" />
          <SolidColorBrush x:Key="PCard" Color="#202020" />
          <SolidColorBrush x:Key="PCode" Color="#252525" />
          <SolidColorBrush x:Key="PCallout" Color="#262626" />
          <SolidColorBrush x:Key="PAccent" Color="#8C9DFF" />
          <SolidColorBrush x:Key="PRed" Color="#FF7369" />
          <SolidColorBrush x:Key="POrange" Color="#FFA344" />
          <SolidColorBrush x:Key="PGreen" Color="#4DAB9A" />
          <SolidColorBrush x:Key="PScrim" Color="#99000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Brand accent (Periwinkle) instead of the user's Windows accent, for checkboxes, primary buttons and focus. -->
      <Color x:Key="SystemAccentColor">#647BFF</Color>
      <Color x:Key="SystemAccentColorLight1">#7C90FF</Color>
      <Color x:Key="SystemAccentColorLight2">#8C9DFF</Color>
      <Color x:Key="SystemAccentColorLight3">#B3BFFF</Color>
      <Color x:Key="SystemAccentColorDark1">#4F64E6</Color>
      <Color x:Key="SystemAccentColorDark2">#3B4FC4</Color>
      <Color x:Key="SystemAccentColorDark3">#293C91</Color>
      <!-- Flat buttons everywhere, like Notion's quiet controls. -->
      <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
      <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
      <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
      <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
      <!-- Borderless text boxes for the editor. -->
      <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,3,0,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsSpellCheckEnabled" Value="True" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
